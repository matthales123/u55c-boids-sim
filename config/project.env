# Generated project defaults
PROJECT_NAME=u55c_boids_sim
U55C_FLOW=both

# U55C target defaults
U55C_PLATFORM=xilinx_u55c_gen3x16_xdma_3_202210_1
U55C_PART=xcu55c-fsvh2892-2L-e
U55C_DEVICE_INDEX=0

# Kernel defaults
U55C_KERNEL_NAME=boids_step
U55C_XCLBIN=build/hardware/hw/boids_step.xclbin
U55C_XCLBIN_RTL=build/hardware/hw/boids_step_rtl.xclbin

# Benchmark defaults
U55C_DEFAULT_ELEMENTS=16384
U55C_DEFAULT_ITERATIONS=10
U55C_SWEEP_SIZES="4096 16384 65536"
U55C_SWEEP_ITERATIONS=10
U55C_SWEEP_MODE=dry-run

# Build defaults
U55C_ENABLE_XRT=ON

# Tool settings paths (adjust if your install path differs)
VITIS_SETTINGS=/tools/Xilinx/2025.1/Vitis/settings64.sh
VIVADO_SETTINGS=/tools/Xilinx/2025.1/Vivado/settings64.sh

# RTL flow defaults
U55C_RTL_PROJECT_NAME=u55c_boids_sim_rtl
U55C_RTL_TOP=boids_step_soa_dual
U55C_RTL_TB_TOP=boids_step_soa_dual_tb
U55C_RTL_MAX_BOIDS=512
